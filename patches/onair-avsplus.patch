diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1acbe57..65ba388 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -58,8 +58,21 @@ if(DECT2_FFMPEG_PREFIX)
   add_library(dect2_ffmpeg INTERFACE)
   target_include_directories(dect2_ffmpeg INTERFACE ${DECT2_FFMPEG_PREFIX}/include)
   target_link_directories(dect2_ffmpeg INTERFACE ${DECT2_FFMPEG_PREFIX}/lib)
-  # the static libraries and what they need (pkg-config's --static output)
-  target_link_libraries(dect2_ffmpeg INTERFACE ${FFMPEG_ST_STATIC_LDFLAGS})
+  # the static libraries and what they need (pkg-config's --static output); a macOS "-framework X" arrives as two list
+  # items, which CMake would link as -lX: join them again
+  set(_ffmpeg_ldflags "")
+  set(_framework OFF)
+  foreach(_f IN LISTS FFMPEG_ST_STATIC_LDFLAGS)
+    if(_framework)
+      list(APPEND _ffmpeg_ldflags "-framework ${_f}")
+      set(_framework OFF)
+    elseif(_f STREQUAL "-framework")
+      set(_framework ON)
+    else()
+      list(APPEND _ffmpeg_ldflags "${_f}")
+    endif()
+  endforeach()
+  target_link_libraries(dect2_ffmpeg INTERFACE ${_ffmpeg_ldflags})
   add_library(PkgConfig::FFMPEG ALIAS dect2_ffmpeg)
   message(STATUS "FFmpeg: static build in ${DECT2_FFMPEG_PREFIX}")
 else()
